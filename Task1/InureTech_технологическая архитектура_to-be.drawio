        <mxCell id="v115" value="HC5" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#B57613;fontStyle=0;spacing=0;strokeColor=none;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1690" y="454" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v116" value="" style="rounded=1;arcSize=10;html=1;fillColor=#F7F9FC;strokeColor=#BDD0EC;strokeWidth=1.6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1780" y="615" width="560" height="410" as="geometry" />
        </mxCell>
        <mxCell id="v117" value="Проверки работоспособности" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=24;fontColor=#183153;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1802" y="635" width="518" height="36" as="geometry" />
        </mxCell>
        <mxCell id="v118" value="&lt;b&gt;HC1 · балансировщик → backends&lt;/b&gt;&lt;br&gt;HTTPS /health/ready; интервал 5 с,&lt;br&gt;таймаут 2 с; 3 сбоя → исключить цель.&lt;br&gt;&lt;br&gt;&lt;b&gt;HC2 · kubelet → Pod: readiness&lt;/b&gt;&lt;br&gt;Готовность к трафику; убрать из endpoints.&lt;br&gt;&lt;b&gt;HC3 · kubelet → Pod: liveness&lt;/b&gt;&lt;br&gt;Зависание процесса; перезапустить Pod.&lt;br&gt;startupProbe защищает медленный старт.&lt;br&gt;&lt;br&gt;&lt;b&gt;HC4 · БД:&lt;/b&gt; доступность primary и репликация.&lt;br&gt;&lt;b&gt;HC5 · снаружи:&lt;/b&gt; пользовательский путь API.&lt;br&gt;Отказ общей БД не должен вызывать&lt;br&gt;массовые рестарты через liveness." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#183153;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1802" y="683" width="516" height="326" as="geometry" />
        </mxCell>
        <mxCell id="v119" value="" style="rounded=1;arcSize=10;html=1;fillColor=#F7F9FC;strokeColor=#BDD0EC;strokeWidth=1.6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1780" y="1050" width="560" height="220" as="geometry" />
        </mxCell>
        <mxCell id="v120" value="Масштабирование и размещение" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=24;fontColor=#183153;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1802" y="1070" width="518" height="36" as="geometry" />
        </mxCell>
        <mxCell id="v121" value="&lt;b&gt;HPA:&lt;/b&gt; количество Pod по метрикам.&lt;br&gt;&lt;b&gt;Cluster Autoscaler:&lt;/b&gt; узлы при нехватке места.&lt;br&gt;requests/limits + распределение по зонам.&lt;br&gt;Запас мощности: две зоны несут всю нагрузку.&lt;br&gt;Состояние запросов не привязано к одному Pod.&lt;br&gt;Плановые обновления: rolling update + PDB." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#183153;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1802" y="1118" width="516" height="136" as="geometry" />
        </mxCell>
        <mxCell id="backups" value="" style="rounded=1;arcSize=10;html=1;fillColor=#FFFFFF;strokeColor=#BDD0EC;strokeWidth=1.6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1780" y="1310" width="560" height="190" as="geometry" />
        </mxCell>
        <mxCell id="v123" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="1800" y="1330" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v124" value="Резервные копии + WAL" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=24;fontColor=#183153;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1856" y="1330" width="464" height="36" as="geometry" />
        </mxCell>
        <mxCell id="v125" value="Управляемое объектное хранилище бэкапов&lt;br&gt;Ежедневный backup + архив WAL → PITR&lt;br&gt;Отдельно от VM и дисков PostgreSQL&lt;br&gt;Контроль свежести и пробное восстановление" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=18;fontColor=#183153;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1802" y="1378" width="516" height="106" as="geometry" />
        </mxCell>
        <mxCell id="e126" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B57613;strokeWidth=2.4;endArrow=block;endFill=1;dashed=1;fontFamily=Arial;fontSize=17;fontColor=#B57613;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg-3" target="backups">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v127" value="Backup / WAL" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#B57613;fontStyle=0;spacing=0;strokeColor=none;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1638" y="1374" width="140" height="28" as="geometry" />
        </mxCell>
        <mxCell id="v128" value="" style="rounded=1;arcSize=10;html=1;fillColor=#FFF7E6;strokeColor=#E6CA93;strokeWidth=1.6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1555" width="2280" height="135" as="geometry" />
        </mxCell>
        <mxCell id="v129" value="ОТКАЗ ОДНОЙ ЗОНЫ" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#B57613;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="82" y="1574" width="470" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v130" value="Клиент сохраняет тот же адрес → балансировщик исключает недоступные цели → две зоны принимают новые запросы.&lt;br&gt;При потере primary: автоматическое переключение БД → переподключение приложения → безопасный повтор операции.&lt;br&gt;Оборванные запросы возможны. Восстановление Pod дополняет уже работающие реплики; подробности и границы — на странице 2." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#183153;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="82" y="1613" width="2230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v131" value="Сплошные синие линии — HTTP(S); зелёные — SQL / репликация; оранжевый пунктир — контроль / резервное копирование. Стрелки показывают направление запроса или передачи данных." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#516580;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="1728" width="2280" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="decisions" name="02 — Отказоустойчивость и решения">
    <mxGraphModel dx="2400" dy="1780" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1780" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="InsureTech · сценарии отказа и обоснование решений" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=34;fontColor=#183153;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1970" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="TASK 1  /  2 из 2" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=right;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#516580;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="2060" y="40" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="Проектные параметры и критерии приёмки · фактические RTO/RPO и производительность подтверждаются испытаниями" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontColor=#516580;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="2280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="" style="rounded=1;arcSize=10;html=1;fillColor=#FFFFFF;strokeColor=#BDD0EC;strokeWidth=1.6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="1110" height="350" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="01  Один кластер в трёх зонах" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#183153;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="136" y="170" width="1014" height="36" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="&lt;b&gt;Выбор:&lt;/b&gt; один управляемый Kubernetes-кластер; control plane и рабочие группы в трёх зонах одного региона.&lt;br&gt;&lt;br&gt;Управляющие узлы сохраняют кворум 2 из 3 при потере одной зоны. Размещение реплик пользовательских сервисов задаётся явно по topology.kubernetes.io/zone и по узлам.&lt;br&gt;&lt;br&gt;Правила размещения должны позволять работу в двух оставшихся зонах; минимум доступных реплик и запас узлов проверяются сценарием отказа.&lt;br&gt;&lt;br&gt;&lt;b&gt;Альтернатива:&lt;/b&gt; независимые кластеры лучше изолируют сбой кластера, но усложняют сеть, релизы и балансировку. Для выбранного сценария отказа одной зоны один кластер достаточен." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#183153;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="82" y="218" width="1066" height="266" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="" style="rounded=1;arcSize=10;html=1;fillColor=#FFFFFF;strokeColor=#BDD0EC;strokeWidth=1.6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1230" y="150" width="1110" height="350" as="geometry" />
        </mxCell>
        <mxCell id="v9" value="02  Масштабирование без шардирования" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#183153;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1252" y="170" width="1068" height="36" as="geometry" />
        </mxCell>
        <mxCell id="v10" value="&lt;b&gt;Приложения:&lt;/b&gt; горизонтально — HPA добавляет Pod, Cluster Autoscaler добавляет узлы. Вертикально подбираются requests/limits и размер VM; один большой сервер не устраняет единую точку отказа.&lt;br&gt;&lt;br&gt;&lt;b&gt;PostgreSQL:&lt;/b&gt; вертикальное увеличение CPU/RAM и диска, индексы, оптимизация запросов и ограниченные пулы соединений. На первом этапе чтение и запись идут в primary; реплики служат резервом.&lt;br&gt;&lt;br&gt;&lt;b&gt;Шардирование не применяется:&lt;/b&gt; 50 GB сами по себе его не обосновывают; выигрыш не подтверждён, а сложность запросов и транзакций возрастает.&lt;br&gt;&lt;br&gt;CPU/RAM, пределы HPA и число узлов выбираются по нагрузочным тестам с учётом роста и работы без одной зоны." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#183153;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1252" y="218" width="1066" height="266" as="geometry" />
        </mxCell>
        <mxCell id="v11" value="" style="rounded=1;arcSize=10;html=1;fillColor=#FFFFFF;strokeColor=#BDD0EC;strokeWidth=1.6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="535" width="1110" height="350" as="geometry" />
        </mxCell>
        <mxCell id="v12" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="80" y="555" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v13" value="03  Балансировка и доступность 24/7" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#183153;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="136" y="555" width="1014" height="36" as="geometry" />
        </mxCell>
        <mxCell id="v14" value="&lt;b&gt;Приложение — active-active:&lt;/b&gt; все три зоны постоянно обслуживают запросы. Один публичный адрес; ALB размещён в трёх зонах, маршруты ведут к готовым Pod через Kubernetes Services и актуальные backend-цели.&lt;br&gt;&lt;br&gt;При отказе зоны входной трафик принимает инфраструктура балансировщика в оставшихся зонах; неработающие backends исключаются по HC1. Проверяется весь путь, включая отказ узлов самого ALB.&lt;br&gt;&lt;br&gt;readiness управляет допуском Pod к трафику; liveness проверяет процесс, а не общую БД. Параметры HC1 на странице 1 — начальные настройки, подлежащие проверке.&lt;br&gt;&lt;br&gt;Rolling update + PodDisruptionBudget ограничивают простой при плановых изменениях. PDB не защищает от аварийного отказа зоны." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#183153;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="82" y="603" width="1066" height="266" as="geometry" />
        </mxCell>
        <mxCell id="v15" value="" style="rounded=1;arcSize=10;html=1;fillColor=#FFFFFF;strokeColor=#BDD0EC;strokeWidth=1.6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1230" y="535" width="1110" height="350" as="geometry" />
        </mxCell>
        <mxCell id="v16" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="1250" y="555" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v17" value="04  Переключение PostgreSQL" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#183153;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1306" y="555" width="1014" height="36" as="geometry" />
        </mxCell>
        <mxCell id="v18" value="&lt;b&gt;БД — primary + две реплики:&lt;/b&gt; синхронная потоковая репликация с кворумом; узлы размещены в разных зонах. Оркестрация и защита от двух одновременно активных primary выполняются управляемым сервисом.&lt;br&gt;&lt;br&gt;При отказе primary оркестратор назначает актуальную реплику новым primary. Приложение подключается через read-write endpoint, обновляет DNS по TTL и пересоздаёт оборванные соединения с ограниченным backoff.&lt;br&gt;&lt;br&gt;Незавершённые транзакции могут откатиться. Если commit выполнен, а ответ потерян, результат неоднозначен: повтор записи допускается только с идемпотентностью или проверкой результата операции.&lt;br&gt;&lt;br&gt;После возврата узел догоняет текущий primary как реплика; немедленное обратное переключение не требуется." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#183153;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1252" y="603" width="1066" height="266" as="geometry" />
        </mxCell>
        <mxCell id="v19" value="" style="rounded=1;arcSize=10;html=1;fillColor=#FFFFFF;strokeColor=#BDD0EC;strokeWidth=1.6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="920" width="1110" height="370" as="geometry" />
        </mxCell>
        <mxCell id="v20" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="80" y="940" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v21" value="05  RTO / RPO и резервное копирование" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#183153;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="136" y="940" width="1014" height="36" as="geometry" />
        </mxCell>
        <mxCell id="v22" value="&lt;b&gt;Отказ одной зоны:&lt;/b&gt; восстановление через живые реплики, без развёртывания из backup. Цель — сохранить подтверждённые транзакции при штатной синхронной репликации и безопасном failover.&lt;br&gt;&lt;br&gt;&lt;b&gt;Удаление / порча данных:&lt;/b&gt; ежедневный backup и архив WAL позволяют PITR — восстановление до выбранного момента. WAL-G / PITR управляемого сервиса; хранение отдельно от дисков БД.&lt;br&gt;&lt;br&gt;&lt;b&gt;RPO ≤ 15 мин:&lt;/b&gt; начальный archive_timeout = 5 мин; контролировать суммарную задержку архивации и загрузки WAL. Порог предупреждения — 10 мин; интервал архивации сам по себе RPO не гарантирует.&lt;br&gt;&lt;br&gt;&lt;b&gt;RTO ≤ 45 мин:&lt;/b&gt; обнаружение + переключение/восстановление + переподключение + проверка. Для PITR заранее обеспечить квоты на новый кластер; время восстановления 50 GB измерить." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#183153;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="82" y="988" width="1066" height="286" as="geometry" />
        </mxCell>
        <mxCell id="v23" value="" style="rounded=1;arcSize=10;html=1;fillColor=#FFFFFF;strokeColor=#BDD0EC;strokeWidth=1.6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1230" y="920" width="1110" height="370" as="geometry" />
        </mxCell>
        <mxCell id="v24" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="1250" y="940" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v25" value="06  География, допущения и ограничения" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#183153;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1306" y="940" width="1014" height="36" as="geometry" />
        </mxCell>
        <mxCell id="v26" value="&lt;b&gt;CDN:&lt;/b&gt; кеш JS/CSS/изображений в точках присутствия ближе к пользователю; источник статики — Web через отказоустойчивый ALB. Персональные ответы API не кешируются публично.&lt;br&gt;&lt;br&gt;&lt;b&gt;Граница решения:&lt;/b&gt; один регион, защита от отказа одного узла или одной зоны. Недоступность всего региона, глобальная ошибка релиза и длительный отказ внешней страховой компании этим размещением не устраняются.&lt;br&gt;&lt;br&gt;&lt;b&gt;Скорость по регионам:&lt;/b&gt; CDN уменьшает задержки статики, но равное время полного открытия страницы и API не гарантирует. Для приёмки согласовать p95 загрузки и API, регионы и допустимый разброс; затем измерить.&lt;br&gt;&lt;br&gt;&lt;b&gt;Доступность 99,9%:&lt;/b&gt; период измерения не задан. При допущении 30 дней бюджет простоя — 43,2 мин; 45 мин RTO не являются допустимой длительностью каждого обычного переключения." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#183153;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1252" y="988" width="1066" height="286" as="geometry" />
        </mxCell>
        <mxCell id="v27" value="" style="rounded=1;arcSize=10;html=1;fillColor=#EDF6F2;strokeColor=#A8CDBD;strokeWidth=1.6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1330" width="2280" height="210" as="geometry" />
        </mxCell>
        <mxCell id="v28" value="ПРОВЕРКА РЕШЕНИЯ ПЕРЕД ВВОДОМ В ЭКСПЛУАТАЦИЮ" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=23;fontColor=#198269;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="84" y="1350" width="2232" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v29" value="1. Под нагрузкой отключить зону с primary: проверить прежний адрес API, исключение целей ALB, доступность двух зон и новый primary.&lt;br&gt;2. Проверить восстановление соединений, сохранность подтверждённых операций и отсутствие дублей при повторе создания заявки.&lt;br&gt;3. Измерить RTO от начала отказа до восстановления обслуживания; проверить запас мощности и восстановление Pod.&lt;br&gt;4. Восстановить 50 GB в новый кластер из backup + WAL: проверить целостность, фактические RPO ≤ 15 мин и RTO ≤ 45 мин.&lt;br&gt;5. Проверить пользовательские сценарии из согласованных регионов; оценить p95 и доступность за согласованный период." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#183153;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="84" y="1396" width="2220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="v30" value="Основания для реализации" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#183153;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="1580" width="2280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v31" value="&lt;a href=&quot;https://kubernetes.io/docs/concepts/scheduling-eviction/topology-spread-constraints/&quot; target=&quot;_blank&quot;&gt;Kubernetes: размещение Pod по зонам&lt;/a&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#3970D6;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="1625" width="735" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v32" value="&lt;a href=&quot;https://yandex.cloud/en/docs/managed-postgresql/concepts/high-availability&quot; target=&quot;_blank&quot;&gt;Yandex Cloud: PostgreSQL — доступность и переключение&lt;/a&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#3970D6;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="820" y="1625" width="735" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v33" value="&lt;a href=&quot;https://yandex.cloud/en/docs/managed-postgresql/concepts/backup&quot; target=&quot;_blank&quot;&gt;Yandex Cloud: PostgreSQL — backup и PITR&lt;/a&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#3970D6;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1625" width="735" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v34" value="RTO/RPO и настройки контролей — проектные цели; результаты испытаний в этом документе не заявляются. Синхронная репликация дополняет, но не заменяет резервное копирование." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#516580;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="1728" width="2280" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>