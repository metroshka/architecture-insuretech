        <mxCell id="consume-settlement-label" value="Каталог + страховки&lt;br&gt;group: settlement&lt;br&gt;Kafka / TLS" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#7950A5;fontStyle=0;spacing=0;fillColor=#FFFFFF;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1620" y="1240" width="245" height="85" as="geometry" />
        </mxCell>
        <object id="request-quotes" c4Type="Relationship" label="" c4Description="request-quotes">
          <mxCell edge="1" parent="1" source="kafka" target="osago" style="edgeStyle=none;orthogonal=1;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;strokeWidth=2.2;strokeColor=#7950A5;fontColor=#7950A5;jumpStyle=arc;jumpSize=10;dashed=1;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.16;entryDx=0;entryDy=0;">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1453" y="1650" />
              </Array>
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="request-quotes-label" value="RequestQuotes&lt;br&gt;group: osago-workers&lt;br&gt;Kafka / TLS" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#7950A5;fontStyle=0;spacing=0;fillColor=#FFFFFF;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1490" y="1520" width="330" height="95" as="geometry" />
        </mxCell>
        <object id="publish-quote-result" c4Type="Relationship" label="" c4Description="publish-quote-result">
          <mxCell edge="1" parent="1" source="osago" target="kafka" style="edgeStyle=none;orthogonal=1;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;strokeWidth=2.2;strokeColor=#7950A5;fontColor=#7950A5;jumpStyle=arc;jumpSize=10;dashed=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.2857142857142857;entryY=1;entryDx=0;entryDy=0;">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1300" y="1810" />
              </Array>
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="publish-quote-result-label" value="Каждый результат из outbox&lt;br&gt;InsurerQuoteUpdated&lt;br&gt;Kafka / TLS" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#7950A5;fontStyle=0;spacing=0;fillColor=#FFFFFF;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1835" width="470" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sse-callout" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;SSE работает с любым экземпляром core-app&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Результат сначала сохраняется в БД.&lt;br&gt;Журнал SSE — источник восстановления.&lt;br&gt;LISTEN/NOTIFY будит все core-app; каждое соединение получает только свои события.&lt;br&gt;Подробнее — страница 4.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="400" y="1700" width="680" height="295" as="geometry" />
        </mxCell>
        <mxCell id="pattern-0" value="R1 · Rate Limiting" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#8A510D;fontStyle=1;spacing=0;rounded=1;fillColor=#FFF1D8;strokeColor=#D8AC68;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1880" y="2030" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="pattern-1" value="R2 · Circuit Breaker" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#8A510D;fontStyle=1;spacing=0;rounded=1;fillColor=#FFF1D8;strokeColor=#D8AC68;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2160" y="2030" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="pattern-2" value="R3 · Retry" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#8A510D;fontStyle=1;spacing=0;rounded=1;fillColor=#FFF1D8;strokeColor=#D8AC68;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2440" y="2030" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="pattern-3" value="R4 · Timeout" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#8A510D;fontStyle=1;spacing=0;rounded=1;fillColor=#FFF1D8;strokeColor=#D8AC68;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2720" y="2030" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="logical-storage" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px;font-weight:bold;margin-bottom:14px&quot;&gt;Размещение и границы данных&lt;/div&gt;&lt;div style=&quot;font-size:19px&quot;&gt;Цилиндры — отдельные схемы сервисов в Managed PostgreSQL из Task1. Сервис читает только своё хранилище. Kafka и правила доставки каталога / реестра — из Task3.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="2150" width="1080" height="175" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px;font-weight:bold;margin-bottom:14px&quot;&gt;Как читать стрелки&lt;/div&gt;&lt;div style=&quot;font-size:19px&quot;&gt;Серый: вызов API от клиента к серверу. Зелёный: доступ к БД.&lt;br&gt;Фиолетовый пунктир: направление сообщений Kafka.&lt;br&gt;Бирюзовый: поток SSE от core-app к Web; соединение открывает Web.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="1160" y="2150" width="1150" height="175" as="geometry" />
        </mxCell>
        <mxCell id="page-guide" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px;font-weight:bold;margin-bottom:14px&quot;&gt;Детали решения&lt;/div&gt;&lt;div style=&quot;font-size:19px&quot;&gt;Страница 2 — контракты и общий срок 60 секунд.&lt;br&gt;Страница 3 — сбои, паттерны и нагрузка.&lt;br&gt;Страница 4 — несколько экземпляров и доставка в браузер.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="2350" y="2150" width="1210" height="175" as="geometry" />
        </mxCell>
        <mxCell id="draft-symbols" value="Паттерны пока обозначены текстом R1–R4. Перед сдачей заменить их значками библиотеки задания; архитектура от этого не меняется." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#8A510D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2340" width="3520" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="task4-api" name="2. API и срок ожидания">
    <mxGraphModel dx="3000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2040" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="ОСАГО · контракты и срок ожидания" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=34;fontColor=#203A59;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="2360" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Все пути и параметры ниже — проектные решения. Реальные адреса API страховых берутся из их контрактов." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#203A59;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="88" width="2500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="page-number" value="2 / 4" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#203A59;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2430" y="36" width="120" height="35" as="geometry" />
        </mxCell>
        <mxCell id="create" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;1. Web → core-app: создать заявку&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;&lt;b&gt;POST /api/osago/applications&lt;/b&gt;&lt;br&gt;Авторизация + Idempotency-Key.&lt;br&gt;Тело: данные для расчёта; core-app проверяет анкету и фиксирует список доступных страховых.&lt;br&gt;&lt;br&gt;Одна транзакция: заявка + acceptedAt + deadlineAt + outbox RequestQuotes.&lt;br&gt;&lt;b&gt;202 Accepted&lt;/b&gt;: applicationId, acceptedAt, deadlineAt.&lt;br&gt;&lt;br&gt;Один ключ + одно тело → та же заявка. Другое тело с тем же ключом → 409. Ключ ограничен пользователем; UNIQUE в БД защищает от гонок.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="1220" height="395" as="geometry" />
        </mxCell>
        <mxCell id="web-read" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;2. Web ↔ core-app: получить результат&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;&lt;b&gt;GET /api/osago/applications/{id}&lt;/b&gt;&lt;br&gt;Снимок состояния, все предложения и lastSeq.&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /api/osago/applications/{id}/events&lt;/b&gt;&lt;br&gt;SSE: offer, insurer-status, completed; id = seq.&lt;br&gt;Каждое предложение показывается сразу после получения, независимо от других страховых.&lt;br&gt;&lt;br&gt;&lt;b&gt;POST /api/osago/applications/{id}/selection&lt;/b&gt;&lt;br&gt;Выбор offerId обрабатывает core-app: принадлежность заявке, срок действия, идемпотентность. Дальнейшее оформление и оплата остаются в core-app.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="1340" y="170" width="1220" height="395" as="geometry" />
        </mxCell>
        <mxCell id="command" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;3. core-app → osago-aggregator: команда&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;&lt;b&gt;osago.quote-requests.v1 · RequestQuotes&lt;/b&gt;&lt;br&gt;key: applicationId; group: osago-workers.&lt;br&gt;&lt;br&gt;eventId, schemaVersion, applicationId, acceptedAt, deadlineAt, insurerIds, quoteInputs.&lt;br&gt;quoteInputs содержит только данные, необходимые страховым для расчёта.&lt;br&gt;&lt;br&gt;Получатель атомарно сохраняет inbox и задания по страховым; затем подтверждает offset. Выполнение HTTP идёт отдельно, не блокируя consumer на 60 секунд.&lt;br&gt;&lt;br&gt;Это асинхронный API агрегатора для core-app. Отдельный REST-запрос на ожидание результата не нужен.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="605" width="1220" height="395" as="geometry" />
        </mxCell>
        <mxCell id="results" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;4. osago-aggregator → core-app: результаты&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;&lt;b&gt;osago.quote-results.v1 · InsurerQuoteUpdated&lt;/b&gt;&lt;br&gt;key: applicationId; group: core-osago.&lt;br&gt;&lt;br&gt;eventId, schemaVersion, applicationId, insurerId, resultVersion, status, completedAt.&lt;br&gt;При предложении: externalRequestId, quoteId, price, currency, terms, validUntil. При сбое — errorCode.&lt;br&gt;&lt;br&gt;Каждый результат сохраняется вместе с outbox и публикуется немедленно, без ожидания остальных компаний.&lt;br&gt;&lt;br&gt;core-app: inbox + состояние предложения + журнал SSE в одной транзакции. Дубли и старые версии не дают повторного эффекта.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="1340" y="605" width="1220" height="395" as="geometry" />
        </mxCell>
        <mxCell id="external-api" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;5. Агрегатор → каждая страховая: REST&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;&lt;b&gt;POST «создать заявку»&lt;/b&gt; → externalRequestId.&lt;br&gt;&lt;b&gt;GET «получить предложение»&lt;/b&gt; по этому идентификатору.&lt;br&gt;&lt;br&gt;До готовности — повторный GET по расписанию, независимо для каждой компании. Начальный интервал polling: 2 секунды со случайным сдвигом; настраивается по квотам и измерениям.&lt;br&gt;&lt;br&gt;Одна недоступная компания не задерживает предложения остальных. В браузер поступает статус каждой страховой: ожидаем, предложение, отказ, ошибка или время истекло.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="1220" height="365" as="geometry" />
        </mxCell>
        <mxCell id="deadline" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;6. Единый deadline — не 60 секунд на попытку&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Принятое решение: deadlineAt = acceptedAt + 60 s.&lt;/b&gt;&lt;br&gt;Отсчёт начинается после принятия заявки core-app; очереди, polling и повторы входят в эти 60 секунд.&lt;br&gt;&lt;br&gt;Начально резервируем последние 2 секунды на доставку результата: агрегатор прекращает внешние вызовы к deadlineAt − 2 s. Резерв проверяется замерами.&lt;br&gt;&lt;br&gt;Каждый HTTP timeout ≤ оставшийся бюджет и настроенный лимит. Просроченная команда не вызывает страховую. Перезапуск не меняет deadlineAt.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1040" width="1220" height="365" as="geometry" />
        </mxCell>
        <mxCell id="complete" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;Завершение поиска и опоздавшие ответы&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Если все страховые ответили раньше — core-app завершает поиск сразу. Иначе его планировщик по сохранённому deadlineAt переводит оставшиеся ожидания в TIMEOUT и добавляет completed в журнал SSE. Уже полученные предложения сохраняются.&lt;br&gt;&lt;br&gt;Браузер использует deadlineAt для таймера: при потере связи прекращает ожидание в срок, показывает частичный результат / проблему связи и запрашивает снимок после восстановления. После completed закрывает EventSource.&lt;br&gt;&lt;br&gt;Поздние результаты сохраняются для аудита и не открывают завершённый поиск заново. При недоступности брокера или БД нельзя обещать доставку всех ответов за 60 секунд; пользователь видит неполный результат, а мониторинг фиксирует нарушение.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="1445" width="2520" height="310" as="geometry" />
        </mxCell>
        <mxCell id="security" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px;font-weight:bold;margin-bottom:14px&quot;&gt;Доступ и границы проекта&lt;/div&gt;&lt;div style=&quot;font-size:19px&quot;&gt;REST, SSE и повторное чтение проверяют владельца заявки. HTTPS; для браузера — защищённая сессионная cookie, для изменяющих запросов — защита CSRF. Токены не передаются в URL. События Kafka защищены TLS и ACL; лишние персональные данные и изображения документов в сообщения и логи не добавляются.&lt;br&gt;Числа 2 s для polling / резерва и 3 s для HTTP timeout — начальные настройки, не подтверждённые результаты нагрузочного теста.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="1790" width="2520" height="175" as="geometry" />
        </mxCell>
        <mxCell id="draft-symbols" value="Паттерны пока обозначены текстом R1–R4. Перед сдачей заменить их значками библиотеки задания; архитектура от этого не меняется." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#8A510D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1990" width="2520" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="task4-resilience" name="3. Сбои и ограничения нагрузки">
    <mxGraphModel dx="3000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2070" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="ОСАГО · сбои и ограничения нагрузки" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=34;fontColor=#203A59;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="2360" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Текстовые обозначения R1–R4 соответствуют меткам на основной схеме. Их заменим значками учебной библиотеки." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#203A59;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="88" width="2500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="page-number" value="3 / 4" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#203A59;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2430" y="36" width="120" height="35" as="geometry" />
        </mxCell>
        <mxCell id="rate" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;R1 · Rate Limiting — ограничиваем поток&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;&lt;b&gt;На входе core-app:&lt;/b&gt; общий для всех экземпляров лимит заявок на пользователя и число активных поисков; счётчики / аренды — в core-db. При превышении — 429 + Retry-After, до создания заявки.&lt;br&gt;&lt;br&gt;&lt;b&gt;На выходе osago-aggregator:&lt;/b&gt; отдельная квота POST / GET и ограничение одновременных HTTP-вызовов для каждой страховой.&lt;br&gt;&lt;br&gt;Общий бюджет делится между всеми экземплярами через атомарное состояние в БД агрегатора; добавление Pod не умножает квоту. Если квоты не позволяют уложиться в срок, ограничиваем приём новых поисков. При недоступности координатора новые внешние вызовы не запускаются.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="1220" height="385" as="geometry" />
        </mxCell>
        <mxCell id="breaker" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;R2 · Circuit Breaker — изолируем сбой страховой&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Для каждой страховой — CLOSED / OPEN / HALF-OPEN.&lt;br&gt;Серия технических ошибок и таймаутов открывает цепь на ограниченное время. Бизнес-отказ в страховке не считается отказом сервиса.&lt;br&gt;&lt;br&gt;В OPEN новые вызовы временно не идут; после паузы — ограниченное число проб. Состояние и бюджет проб согласуются через БД агрегатора для всех экземпляров.&lt;br&gt;&lt;br&gt;Остальные страховые продолжают работу. Если восстановление не укладывается в deadline, фиксируем ошибку / недоступность этой компании и передаём её в core-app.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="1340" y="170" width="1220" height="385" as="geometry" />
        </mxCell>
        <mxCell id="retry" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;R3 · Retry — повторяем только безопасные операции&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;GET: ограниченные повторы временных сетевых ошибок, 429 и подходящих 5xx. Backoff + jitter; учитываем Retry-After и оставшееся время. Постоянные 4xx и бизнес-отказы не повторяем.&lt;br&gt;&lt;br&gt;POST: один стабильный ключ applicationId + insurerId при поддержке идемпотентности страховой. После сбоя повторяем с тем же ключом.&lt;br&gt;&lt;br&gt;&lt;b&gt;Если страховая не поддерживает защиту от дублей:&lt;/b&gt; после неоднозначного таймаута / падения процесса POST автоматически не повторяем. Фиксируем UNKNOWN, показываем техническую проблему и запускаем сверку. Двух заданных API недостаточно, чтобы всегда определить результат потерянного POST.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="595" width="1220" height="425" as="geometry" />
        </mxCell>
        <mxCell id="timeout" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;R4 · Timeout — ограничиваем время каждой операции&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;На каждый HTTP-вызов: connect/read timeout и общий лимит попытки, например 3 s, но не больше оставшегося бюджета до рабочего cutoff.&lt;br&gt;&lt;br&gt;Общий deadline контролируют и core-app, и агрегатор. Очередь, повторы, ожидание доступного лимита и polling не продлевают 60 секунд.&lt;br&gt;&lt;br&gt;После cutoff не запускаем новые внешние попытки, незавершённые отменяем локально. Отмена HTTP не означает, что страховая отменила уже созданную заявку.&lt;br&gt;&lt;br&gt;Недоступная страховая не блокирует общий поток: возвращаем остальные предложения и конечный статус для неё.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="1340" y="595" width="1220" height="425" as="geometry" />
        </mxCell>
        <mxCell id="capacity" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;Что означает нагрузка 2 500 пользователей&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;При 10 страховых одна волна создаёт до &lt;b&gt;25 000 заданий&lt;/b&gt; и около &lt;b&gt;2 500 SSE-соединений&lt;/b&gt;. Задания — записи состояния; для каждого не выделяется ожидающий поток ОС.&lt;br&gt;&lt;br&gt;Иллюстрация верхней оценки: если все 25 000 заданий ещё ожидают и polling идёт раз в 2 s, получится до &lt;b&gt;12 500 GET/s&lt;/b&gt; суммарно, около 1 250 GET/s на страховую. POST добавляет свою нагрузку.&lt;br&gt;&lt;br&gt;Это расчёт, а не подтверждённая пропускная способность. Нужны квоты страховых, скорость поступления новых заявок и измерения; 2 500 одновременных пользователей само по себе не задаёт RPS.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="1220" height="405" as="geometry" />
        </mxCell>
        <mxCell id="scaling" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;Как масштабируем и защищаем ресурсы&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Асинхронный HTTP-клиент, ограниченные пулы соединений и число активных jobs. Планировщик хранит nextPollAt; не держит транзакцию или consumer Kafka открытыми во время ожидания ответа.&lt;br&gt;&lt;br&gt;Реплики core-app масштабируются по CPU / памяти / активным SSE, агрегатора — по возрасту очереди и активным заданиям. Предел — внешние квоты и ресурсы БД, поэтому HPA не заменяет ограничения нагрузки.&lt;br&gt;&lt;br&gt;Kafka: группы core-osago и osago-workers; параллелизм чтения ограничен числом партиций. Внутри агрегатора задания разных страховых исполняются независимо с общими лимитами.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1040" width="1220" height="405" as="geometry" />
        </mxCell>
        <mxCell id="outages" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;Когда недоступны Kafka или PostgreSQL&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Kafka недоступна → события остаются в outbox; после восстановления публикуются с прежним eventId. Истёкшую команду агрегатор завершает без обращения к страховым.&lt;br&gt;БД недоступна → не подтверждаем необработанные offsets; core-app не возвращает 202 без сохранённой заявки. HTTP-вызовы без сохранённого состояния не начинаем.&lt;br&gt;Ошибочное сообщение → ограниченный retry, затем карантин + оповещение. Ошибка не превращается в успешное предложение; пользовательский deadline всё равно действует.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="1485" width="2520" height="230" as="geometry" />
        </mxCell>
        <mxCell id="verification" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:14px&quot;&gt;Что проверить при реализации&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;Измерить: принятие → первое предложение, задержку Kafka / outbox / SSE, долю ответов в срок, 429/5xx/таймауты по страховым, возраст jobs и число соединений.&lt;br&gt;Проверки: 2 500 клиентов; медленная / недоступная страховая; повтор POST и события Kafka; перезапуск Pod; разрыв SSE; сбой брокера и БД. Убедиться в отсутствии дублей и продления deadline.&lt;br&gt;&lt;b&gt;Это план проверки архитектуры. Нагрузочный тест ОСАГО в Task4 не выполнялся.&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="1755" width="2520" height="185" as="geometry" />
        </mxCell>
        <mxCell id="draft-symbols" value="Паттерны пока обозначены текстом R1–R4. Перед сдачей заменить их значками библиотеки задания; архитектура от этого не меняется." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#8A510D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1985" width="2520" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="task4-replicas" name="4. Экземпляры и доставка в Web">
    <mxGraphModel dx="3000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2250" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="ОСАГО · несколько экземпляров и доставка в браузер" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=34;fontColor=#203A59;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="2360" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Outbox / inbox дают повторяемую обработку; журнал SSE восстанавливает клиентское соединение." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#203A59;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="88" width="2500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="page-number" value="4 / 4" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#203A59;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="2430" y="36" width="120" height="35" as="geometry" />
        </mxCell>
        <mxCell id="result-consumer" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;core-app · экземпляр A&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Consumer результата Kafka&lt;br&gt;TX: inbox + предложение + журнал SSE&lt;br&gt;После COMMIT — подтверждение offset&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="650" height="190" as="geometry" />
        </mxCell>
        <mxCell id="journal" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:14px&quot;&gt;core-db · единый источник состояния&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;События приложения: applicationId, seq, type, payload&lt;br&gt;NOTIFY с applicationId — только сигнал&lt;br&gt;История сохраняется в таблице&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="970" y="170" width="700" height="190" as="geometry" />
        </mxCell>
        <mxCell id="sse-instance" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:24px;font-weight:bold;margin-bottom:14px&quot;&gt;core-app · экземпляр B / C / …&lt;/div&gt;&lt;div style=&quot;font-size:21px&quot;&gt;LISTEN + дочитывание журнала&lt;br&gt;Собственные SSE-соединения с браузерами&lt;br&gt;Доставка только авторизованным владельцам&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="1950" y="170" width="610" height="190" as="geometry" />
        </mxCell>
        <object id="result-db" c4Type="Relationship" label="" c4Description="result-db">
          <mxCell edge="1" parent="1" source="result-consumer" target="journal" style="edgeStyle=none;orthogonal=1;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;strokeWidth=2.2;strokeColor=#177F79;fontColor=#177F79;jumpStyle=arc;jumpSize=10;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="result-db-label" value="Одна транзакция&lt;br&gt;SQL / TLS" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#177F79;fontStyle=0;spacing=0;fillColor=#FFFFFF;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="710" y="215" width="240" height="65" as="geometry" />
        </mxCell>
        <object id="db-notify" c4Type="Relationship" label="" c4Description="db-notify">
          <mxCell edge="1" parent="1" source="journal" target="sse-instance" style="edgeStyle=none;orthogonal=1;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;strokeWidth=2.2;strokeColor=#087F8C;fontColor=#087F8C;jumpStyle=arc;jumpSize=10;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="db-notify-label" value="NOTIFY после COMMIT&lt;br&gt;+ чтение журнала" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#087F8C;fontStyle=0;spacing=0;fillColor=#FFFFFF;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1690" y="215" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="persist" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;1. Агрегатор переживает рестарт&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;В своей схеме PostgreSQL сохраняет задания, externalRequestId, состояние, nextPollAt, deadlineAt, результат и inbox/outbox.&lt;br&gt;&lt;br&gt;UNIQUE(applicationId, insurerId) не позволяет создать второе внутреннее задание. Работник получает lease с fencing token; изменения состояния принимаются только от актуального владельца. Просроченную аренду может забрать другой экземпляр.&lt;br&gt;&lt;br&gt;Сетевой вызов выполняется вне транзакции. Lease сам по себе не предотвращает дубль внешнего POST после сбоя — нужен ключ страховой либо UNKNOWN / сверка, как на странице 3.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1220" height="380" as="geometry" />
        </mxCell>
        <mxCell id="dedup" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;2. Повторы сообщений не меняют результат дважды&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Доставка Kafka — at-least-once. eventId в inbox с UNIQUE и обновление данных выполняются одной транзакцией. Offset подтверждается после COMMIT, без пропуска ещё не обработанных записей партиции.&lt;br&gt;&lt;br&gt;Ключ обоих новых topics — applicationId. Результат страховой имеет монотонную resultVersion; старое событие не перезаписывает новое. Publisher не переставляет версии одного ключа.&lt;br&gt;&lt;br&gt;Все реплики агрегатора входят в osago-workers; все обработчики результатов core-app — в core-osago. Это разные группы. Каталог и реестр сохраняют группы Task3.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="1340" y="400" width="1220" height="380" as="geometry" />
        </mxCell>
        <mxCell id="journal-rules" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;3. Журнал SSE и согласованный порядок&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;core-app атомарно сохраняет предложение, inbox и событие SSE. Для выдачи seq блокирует строку заявки и увеличивает счётчик внутри той же транзакции: порядок seq согласован с фиксацией событий этой заявки.&lt;br&gt;&lt;br&gt;В той же транзакции выполняет NOTIFY с applicationId; PostgreSQL отправляет сигнал после COMMIT. В NOTIFY нет персональных данных и самого предложения.&lt;br&gt;&lt;br&gt;Сигнал получают все слушающие экземпляры core-app, поэтому Kafka consumer может работать в A, а браузер быть подключён к B. Sticky sessions не требуются.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="1220" height="380" as="geometry" />
        </mxCell>
        <mxCell id="listen-recovery" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;4. LISTEN/NOTIFY — сигнал, не надёжная очередь&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Каждый core-app держит отдельное постоянное LISTEN-соединение к PostgreSQL, не по одному на браузер и не через transaction pooling.&lt;br&gt;&lt;br&gt;Сначала активирует LISTEN и фиксирует его, затем читает журнал; сигнал будит чтение только для заявок с локальными активными соединениями. Новый SSE-подписчик тоже сразу дочитывает журнал.&lt;br&gt;&lt;br&gt;Для пропущенных сигналов — пакетная проверка журнала примерно раз в 1 s. После разрыва соединения / failover БД: повторный LISTEN и дочитывание. Источник истины — таблица, а не память Pod.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="1340" y="820" width="1220" height="380" as="geometry" />
        </mxCell>
        <mxCell id="reconnect" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;5. Браузер переподключается к любому Pod&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Каждое SSE-событие содержит id: seq. При разрыве EventSource передаёт Last-Event-ID; любой core-app дочитывает события этой заявки после указанного seq.&lt;br&gt;&lt;br&gt;При первой загрузке Web получает снимок + lastSeq, затем открывает SSE с after=lastSeq. При повторном подключении Last-Event-ID имеет приоритет. Если история очищена — заново снимок и новый курсор.&lt;br&gt;&lt;br&gt;Браузер игнорирует уже применённые seq / версии. Срок хранения журнала должен покрывать поддерживаемое окно восстановления. После completed соединение закрывается.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="1240" width="1220" height="380" as="geometry" />
        </mxCell>
        <mxCell id="sse-transport" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;6. Соединение и медленный клиент&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;SSE идёт по HTTPS; балансировщик / прокси не буферизует поток. Heartbeat, например каждые 15 s; idle timeout прокси больше интервала heartbeat. Для Web — HTTP/2.&lt;br&gt;&lt;br&gt;Неблокирующая отправка; ограниченный буфер на соединение. Если браузер не успевает читать, закрываем соединение и восстанавливаем события из журнала после переподключения.&lt;br&gt;&lt;br&gt;Проверяем лимиты соединений и ресурсов при 2 500 клиентах. REST-снимки и SSE не кешируются общим CDN; владелец заявки проверяется также при replay.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="1340" y="1240" width="1220" height="380" as="geometry" />
        </mxCell>
        <mxCell id="completion-concurrency" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:14px&quot;&gt;Завершение тоже устойчиво к гонкам&lt;/div&gt;&lt;div style=&quot;font-size:22px&quot;&gt;Планировщик core-app выбирает незавершённые заявки с истёкшим deadline. Переход в конечное состояние и запись completed выполняются под блокировкой строки заявки в одной транзакции. Несколько экземпляров не создают несколько завершений.&lt;br&gt;Обработка предложения проверяет это же состояние и deadline; пришедшее после завершения событие сохраняется для аудита. Восстановление после сбоя не запускает новый отсчёт 60 секунд.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="1660" width="2520" height="205" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="&lt;div style=&quot;font-family:Arial;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:23px;font-weight:bold;margin-bottom:14px&quot;&gt;Опорные механизмы и границы&lt;/div&gt;&lt;div style=&quot;font-size:20px&quot;&gt;PostgreSQL LISTEN / NOTIFY: уведомления получает каждая слушающая сессия, а долговечность обеспечивает наш журнал.&lt;br&gt;SSE: стандартные EventSource и Last-Event-ID; защита от дублей и срок хранения — ответственность приложения.&lt;br&gt;POST страховой: автоматические повторы безопасны только при согласованной идемпотентности или достоверно известном отсутствии эффекта.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#F2F6FA;strokeColor=#C2D1E2;fontColor=#203A59;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="1905" width="2520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="source-links" value="&lt;a href=&quot;https://www.postgresql.org/docs/current/sql-notify.html&quot;&gt;PostgreSQL NOTIFY&lt;/a&gt; · &lt;a href=&quot;https://www.postgresql.org/docs/current/sql-listen.html&quot;&gt;LISTEN&lt;/a&gt; · &lt;a href=&quot;https://html.spec.whatwg.org/multipage/server-sent-events.html&quot;&gt;SSE / EventSource&lt;/a&gt; · &lt;a href=&quot;https://www.rfc-editor.org/rfc/rfc9110.html#section-9.2.2&quot;&gt;HTTP: идемпотентность&lt;/a&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#203A59;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2110" width="2520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="draft-symbols" value="Паттерны пока обозначены текстом R1–R4. Перед сдачей заменить их значками библиотеки задания; архитектура от этого не меняется." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#8A510D;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2180" width="2520" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>